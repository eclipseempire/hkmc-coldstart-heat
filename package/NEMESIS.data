[nemesis]
version=1.1
id=coldstart.heat
name=Cold-start Heat
type=application,service
package-version=1.4.1
short-desc="Auto heated wheel + seats on cold start"
os="*.260507"
models=any
postinstall=scripts/post.sh

[app.0]
kind=apk
path=app/coldstart.apk
package=com.nemesis.coldstart
component=com.nemesis.coldstart/.MainActivity

[service.0]
name=apply
kind=sh
path=svc/coldstart.sh
uid=root
mode=background
